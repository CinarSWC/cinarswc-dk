---
import Base from "../layouts/Base.astro";
---

<Base title="Siden blev ikke fundet — Cinar Software Consulting" noindex>
  <section class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-start justify-center px-6 py-24 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      Siden findes desværre ikke
    </h1>
    <p class="mt-4 max-w-md text-lg leading-relaxed text-muted">
      Linket kan være forældet, eller siden er flyttet. Gå tilbage til
      forsiden for at finde det, du leder efter.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3.5 text-sm font-semibold text-accent-ink transition-transform hover:scale-[1.02]"
    >
      Til forsiden
    </a>
  </section>
</Base>

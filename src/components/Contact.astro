---
import Icon from "./Icon.astro";
import { site } from "../config";
---

<section id="kontakt" class="scroll-mt-20 border-t border-border py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent">Kontakt</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        Lad os tale om jeres næste projekt
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Skriv et par ord om opgaven, så vender vi tilbage hurtigst muligt —
        eller send en mail direkte.
      </p>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="space-y-6">
        <a
          href={`mailto:${site.email}`}
          class="flex items-center gap-4 rounded-2xl border border-border bg-surface p-6 shadow-card transition-colors hover:bg-accent-soft"
        >
          <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent">
            <Icon name="mail" class="size-5" />
          </span>
          <span>
            <span class="block text-sm text-muted">E-mail</span>
            <span class="font-semibold text-ink">{site.email}</span>
          </span>
        </a>

        <div class="flex items-center gap-4 rounded-2xl border border-border bg-surface p-6 shadow-card">
          <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent">
            <Icon name="phone" class="size-5" />
          </span>
          <span>
            <span class="block text-sm text-muted">Telefon</span>
            <span class="font-semibold text-ink">{site.phone}</span>
          </span>
        </div>

        <div class="flex items-start gap-4 rounded-2xl border border-border bg-surface p-6 shadow-card">
          <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent">
            <Icon name="pin" class="size-5" />
          </span>
          <span>
            <span class="block text-sm text-muted">Adresse</span>
            <span class="font-semibold text-ink">{site.address.line1}</span>
            <span class="block font-semibold text-ink">{site.address.line2}</span>
          </span>
        </div>
      </div>

      <form
        id="contact-form"
        class="space-y-5 rounded-2xl border border-border bg-surface p-7 shadow-card sm:p-8"
        action="https://api.web3forms.com/submit"
        method="POST"
      >
        <input type="hidden" name="access_key" value={site.web3formsAccessKey} />
        <input type="hidden" name="subject" value="Ny henvendelse fra cinarswc.dk" />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

        <div>
          <label for="name" class="mb-1.5 block text-sm font-medium text-ink">Navn</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="w-full rounded-lg border border-border bg-canvas px-4 py-2.5 text-ink placeholder:text-muted focus:border-accent focus:outline-none"
            placeholder="Dit fulde navn"
          />
        </div>

        <div>
          <label for="email" class="mb-1.5 block text-sm font-medium text-ink">E-mail</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="w-full rounded-lg border border-border bg-canvas px-4 py-2.5 text-ink placeholder:text-muted focus:border-accent focus:outline-none"
            placeholder="dig@virksomhed.dk"
          />
        </div>

        <div>
          <label for="message" class="mb-1.5 block text-sm font-medium text-ink">Besked</label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            class="w-full resize-y rounded-lg border border-border bg-canvas px-4 py-2.5 text-ink placeholder:text-muted focus:border-accent focus:outline-none"
            placeholder="Fortæl kort om opgaven"></textarea>
        </div>

        <button
          type="submit"
          class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-accent px-6 py-3.5 text-sm font-semibold text-accent-ink transition-transform hover:scale-[1.01] disabled:opacity-60 disabled:hover:scale-100 sm:w-auto"
        >
          <span data-label>Send besked</span>
        </button>

        <p
          id="form-status"
          class="text-sm"
          role="status"
          aria-live="polite"
        ></p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const labelSpan = submitButton?.querySelector<HTMLSpanElement>("[data-label]");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status || !submitButton || !labelSpan) return;

    const defaultLabel = labelSpan.textContent ?? "Send besked";
    submitButton.disabled = true;
    labelSpan.textContent = "Sender…";
    status.textContent = "";
    status.className = "text-sm";

    try {
      const formData = new FormData(form);
      const response = await fetch(form.action, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: formData,
      });
      const result = await response.json();

      if (response.status === 200) {
        status.textContent = "Tak for din besked! Vi vender tilbage hurtigst muligt.";
        status.classList.add("text-accent");
        form.reset();
      } else {
        console.error(result);
        status.textContent = "Noget gik galt. Prøv igen, eller skriv direkte til info@cinarswc.dk.";
        status.classList.add("text-red-600");
      }
    } catch (error) {
      console.error(error);
      status.textContent = "Noget gik galt. Prøv igen, eller skriv direkte til info@cinarswc.dk.";
      status.classList.add("text-red-600");
    } finally {
      submitButton.disabled = false;
      labelSpan.textContent = defaultLabel;
    }
  });
</script>

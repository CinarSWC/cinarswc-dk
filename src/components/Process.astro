---
import { process } from "../config";
---

<section id="proces" class="scroll-mt-20 border-t border-border py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent">Proces</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        Sådan arbejder vi
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        En struktureret proces, der holder projektet forudsigeligt fra
        første samtale til overdraget løsning.
      </p>
    </div>

    <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        process.map((item, index) => (
          <li class="relative pl-0">
            <span class="block text-sm font-semibold tabular-nums text-accent">{item.step}</span>
            <h3 class="mt-3 text-lg font-semibold text-ink">{item.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">{item.description}</p>
            {index < process.length - 1 && (
              <span
                class="absolute right-[-1rem] top-1.5 hidden h-px w-8 bg-border lg:block"
                aria-hidden="true"
              />
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

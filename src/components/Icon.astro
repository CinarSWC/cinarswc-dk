---
type Props = {
  name:
    | "layout"
    | "devices"
    | "shield"
    | "server"
    | "workflow"
    | "sparkles"
    | "arrow-right"
    | "menu"
    | "close"
    | "mail"
    | "check"
    | "phone"
    | "pin"
    | "sun"
    | "moon"
    | "logo";
  class?: string;
};

const { name, class: className = "size-6" } = Astro.props;
---

{
  name === "layout" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5" />
      <path d="M3 9H21" stroke="currentColor" stroke-width="1.5" />
      <path d="M9 9V21" stroke="currentColor" stroke-width="1.5" />
    </svg>
  )
}
{
  name === "devices" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <rect x="2.5" y="4" width="13" height="10" rx="1.5" stroke="currentColor" stroke-width="1.5" />
      <path d="M6 17.5H12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <rect x="16.5" y="8" width="5" height="10" rx="1.2" stroke="currentColor" stroke-width="1.5" />
      <path d="M18.5 16H19.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  )
}
{
  name === "shield" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path
        d="M12 3L19.5 6V11.5C19.5 16.14 16.36 20.24 12 21.5C7.64 20.24 4.5 16.14 4.5 11.5V6L12 3Z"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
      <path d="M9 12L11 14L15.5 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === "server" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <rect x="3" y="4" width="18" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.5" />
      <rect x="3" y="13.5" width="18" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.5" />
      <path d="M6.5 7.25H8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path d="M6.5 16.75H8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  )
}
{
  name === "workflow" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <rect x="2.5" y="4" width="6" height="6" rx="1.2" stroke="currentColor" stroke-width="1.5" />
      <rect x="15.5" y="4" width="6" height="6" rx="1.2" stroke="currentColor" stroke-width="1.5" />
      <rect x="9" y="14" width="6" height="6" rx="1.2" stroke="currentColor" stroke-width="1.5" />
      <path d="M5.5 10V12C5.5 13.1 6.4 14 7.5 14H9M18.5 10V12C18.5 13.1 17.6 14 16.5 14H15" stroke="currentColor" stroke-width="1.5" />
    </svg>
  )
}
{
  name === "sparkles" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path
        d="M11 3L12.4 8.1L17.5 9.5L12.4 10.9L11 16L9.6 10.9L4.5 9.5L9.6 8.1L11 3Z"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linejoin="round"
      />
      <path d="M18.5 14L19.2 16.3L21.5 17L19.2 17.7L18.5 20L17.8 17.7L15.5 17L17.8 16.3L18.5 14Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === "arrow-right" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path d="M4 12H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path d="M14 6L20 12L14 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === "menu" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path d="M3.5 6.5H20.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      <path d="M3.5 12H20.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      <path d="M3.5 17.5H20.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  )
}
{
  name === "close" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path d="M5 5L19 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      <path d="M19 5L5 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  )
}
{
  name === "mail" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <rect x="2.5" y="5" width="19" height="14" rx="2" stroke="currentColor" stroke-width="1.5" />
      <path d="M3.5 6.5L12 13L20.5 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === "check" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.5" />
      <path d="M8 12.5L10.7 15L16 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === "phone" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path
        d="M5 4H8.5L10 8.5L7.8 10C8.6 12 10 13.4 12 14.2L13.5 12L18 13.5V17C18 18.1 17.1 19 16 19C9.9 18.6 5.4 14.1 5 8C5 6.9 5 4 5 4Z"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linejoin="round"
      />
    </svg>
  )
}
{
  name === "pin" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path
        d="M12 21C12 21 18.5 15.4 18.5 10.5C18.5 6.9 15.6 4 12 4C8.4 4 5.5 6.9 5.5 10.5C5.5 15.4 12 21 12 21Z"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
      <circle cx="12" cy="10.5" r="2.25" stroke="currentColor" stroke-width="1.5" />
    </svg>
  )
}
{
  name === "sun" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <circle cx="12" cy="12" r="4.25" stroke="currentColor" stroke-width="1.5" />
      <path
        d="M12 2.6V4.4M12 19.6V21.4M21.4 12H19.6M4.4 12H2.6M18.65 5.35L17.38 6.62M6.62 17.38L5.35 18.65M18.65 18.65L17.38 17.38M6.62 6.62L5.35 5.35"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      />
    </svg>
  )
}
{
  name === "moon" && (
    <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
      <path
        d="M20.6 13.6A8.6 8.6 0 0 1 10.4 3.4A8.6 8.6 0 1 0 20.6 13.6Z"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
    </svg>
  )
}
{
  /*
   * "Ç" — the cedilla is drawn as a small pointed leaf blade, a nod to
   * "Çınar" (Turkish for plane/sycamore tree), the word the company name
   * is derived from.
   */
  name === "logo" && (
    <svg viewBox="0 0 32 32" fill="none" class={className} aria-hidden="true">
      <rect x="1" y="1" width="30" height="30" rx="8" stroke="currentColor" stroke-width="1.6" />
      <path d="M20.5 12C19.4 10.5 17.8 9.6 16 9.6C12.9 9.6 10.4 12.1 10.4 16C10.4 19.9 12.9 22.4 16 22.4C17.8 22.4 19.4 21.5 20.5 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      <path d="M16 22.5 Q13.6 24 13.1 27.4 Q15.9 25.8 16 22.5 Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round" />
      <path d="M15.9 22.9 L13.4 27" stroke="currentColor" stroke-width="0.85" stroke-linecap="round" />
    </svg>
  )
}

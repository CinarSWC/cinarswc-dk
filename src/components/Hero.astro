---
import Icon from "./Icon.astro";
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-x-0 -top-24 -z-10 h-[32rem] bg-[radial-gradient(60%_50%_at_50%_0%,var(--color-accent-soft),transparent)]"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-6xl px-6 pb-20 pt-16 sm:pb-28 sm:pt-24 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent">
      Softwarerådgivning
    </p>
    <h1
      class="mt-4 max-w-3xl text-[clamp(2.25rem,5vw,3.5rem)] font-semibold leading-[1.08] tracking-tight text-ink"
    >
      Softwarerådgivning, der flytter forretningen.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
      Cinar Software Consulting hjælper virksomheder med at designe og bygge
      software, der holder — fra applikationsarkitektur og sikker
      adgangsstyring til agentiske AI-workflows og generativ AI forankret i
      egne data.
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-4">
      <a
        href="#kontakt"
        class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3.5 text-sm font-semibold text-accent-ink shadow-card transition-transform hover:scale-[1.02]"
      >
        Kontakt os
        <Icon name="arrow-right" class="size-4" />
      </a>
      <a
        href="#ydelser"
        class="inline-flex items-center gap-2 rounded-full border border-border px-6 py-3.5 text-sm font-semibold text-ink transition-colors hover:bg-accent-soft"
      >
        Se ydelser
      </a>
    </div>
  </div>
</section>

---
import { site, nav } from "../config";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-canvas">
  <div class="mx-auto max-w-6xl px-6 py-14 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr]">
      <div>
        <a href="#main" class="flex items-center gap-2.5 font-semibold text-ink">
          <Icon name="logo" class="size-7 text-accent" />
          {site.name}
        </a>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">
          {site.description}
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-ink">Navigation</h3>
        <ul class="mt-4 space-y-2.5">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-muted hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/privatlivspolitik" class="text-sm text-muted hover:text-ink">
              Privatlivspolitik
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-ink">Virksomhedsoplysninger</h3>
        <ul class="mt-4 space-y-2.5 text-sm text-muted">
          <li>{site.name}</li>
          <li>CVR: {site.cvr}</li>
          <li>{site.address.line1}</li>
          <li>{site.address.line2}</li>
          <li>
            <a href={`mailto:${site.email}`} class="hover:text-ink">{site.email}</a>
          </li>
          <li>{site.phone}</li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-border pt-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {site.name}. Alle rettigheder forbeholdes.</p>
      <p>CVR {site.cvr} &middot; {site.domain}</p>
    </div>
  </div>
</footer>
